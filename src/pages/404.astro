---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils';
---

<BaseLayout title="404" description="页面走丢了。">
  <section class="container error-page" data-hero>
    <p class="eyebrow mono">// NOT FOUND</p>
    <div class="error-page__code">404</div>
    <h1 class="error-page__title">这一页还没被写下来。</h1>
    <p class="error-page__desc">
      链接可能拼错了，或者这篇文章已经被移走。回到首页，或者去文章列表里找找。
    </p>
    <div class="hero__actions">
      <a class="btn btn--solid" href={withBase('/')} data-magnetic>
        回到首页
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn btn--ghost" href={withBase('/blog/')} data-magnetic>
        浏览文章
      </a>
    </div>
  </section>
</BaseLayout>
