---
import { SITE, NAV } from '../consts';
import { withBase } from '../utils';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const current = base && path.startsWith(base) ? path.slice(base.length) : path;
const normalized = current.replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
  const target = href.replace(/\/$/, '') || '/';
  if (target === '/') return normalized === '/';
  return normalized === target || normalized.startsWith(`${target}/`);
}
---

<header class="topbar" data-topbar>
  <div class="topbar__inner">
    <a class="brand" href={withBase('/')} aria-label={`${SITE.name} 首页`}>
      <span class="brand__avatar">
        <img
          src={withBase('/images/avatar-192.jpg')}
          alt=""
          width="192"
          height="192"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </span>
      <span class="brand__text">
        <span class="brand__name">{SITE.latinName}</span>
        <span class="brand__seal">の</span>
        <span class="brand__after">记录之地</span>
      </span>
    </a>

    <nav class="nav" aria-label="主导航">
      {
        NAV.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={withBase(item.href)}
              class:list={['nav__link', { 'is-active': active }]}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
              {active && <span class="nav__dot" aria-hidden="true" />}
            </a>
          );
        })
      }
    </nav>

    <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换明暗主题">
      <svg
        class="icon-sun"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
      </svg>
      <svg
        class="icon-moon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 9.8 9.8Z"></path>
      </svg>
    </button>
  </div>
</header>
